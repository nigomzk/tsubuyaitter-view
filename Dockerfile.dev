FROM node:22-slim
WORKDIR /app

ENV NODE_ENV=development
ENV LOG_LEVEL=info

# ログディレクトリの作成
RUN mkdir -p /app/logs

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    wget \
    ca-certificates \
    curl \
    git \
    procps \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
RUN npm ci

COPY prisma ./prisma
RUN npx prisma generate

EXPOSE 3000
CMD ["npm", "run", "dev"]