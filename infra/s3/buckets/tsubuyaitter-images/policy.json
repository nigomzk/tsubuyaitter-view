{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "PublicReadOnlyAccess",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::tsubuyaitter-images/*"
        },
        {
            "Sid": "AllowPutObjectFromEcsOnly",
            "Effect": "Allow",
            "Principal": {
                "AWS": [
                    "arn:aws:iam::123456789012:role/ecsTaskExecutionRole"
                ]
            },
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::tsubuyaitter-images/*"
            ]
        }
    ]
}